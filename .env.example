# ══════════════════════════════════════════════════════════════════
# VoidStream / Nitiflix - Variables de Entorno
# ══════════════════════════════════════════════════════════════════
#
# MODO POSTGRESQL (default desde v6.0, máxima velocidad):
#   1. Arrancar PostgreSQL: docker run -d --name voidstream-pg \
#        -e POSTGRES_HOST_AUTH_METHOD=trust -e POSTGRES_DB=voidstream \
#        -e POSTGRES_USER=voidstream -e POSTGRES_PASSWORD=voidstream123 \
#        -p 5433:5432 postgres:16-alpine
#   2. Copia este archivo: cp .env.example .env
#   3. npx prisma db push && npx prisma generate
#   4. Migra datos: npx tsx tools/fast-migrate-pg.ts
#   5. Agrega full-text search: npx tsx tools/add-fulltext-search.ts
#   6. Arranca: npm run dev
#
# ══════════════════════════════════════════════════════════════════

DATABASE_URL="postgresql://voidstream:voidstream123@localhost:5433/voidstream?schema=public"
# DATABASE_URL="postgresql://user:password@localhost:5432/voidstream?schema=public"

# ── Administración ──
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-contrasena
ADMIN_SESSION_SECRET=genera-un-secreto-largo-y-aleatorio

# ── TMDB ──
TMDB_API_KEY=
# TMDB_MAX_RPS=35

# ── Direct Provider Gateway ──────────────────────────────────────
# Primary movie/TV APIs are queried in parallel and MUST resolve to
# HLS/DASH/MP4. Embeds/pages are discarded from the primary path.
FLIXQUEST_API_URL=https://flixquest-api.vercel.app
FLIXQUEST_PROVIDER_IDS=showbox,vidsrc,vidsrcto
NUVIO_STREAMS_URL=https://nuviostreams.hayd.uk

# Optional: self-host byteful/StreamProvider-compatible endpoint.
# The upstream project is archived, so this is disabled unless configured.
# STREAM_PROVIDER_URL=https://your-streamprovider.example/

# Anime SDK server. Self-host anime-sdk with /meta/search + /meta/stream.
# Leaving this empty disables only this primary anime client; local anime
# adapters remain available as Spanish/fallback candidates.
ANIME_SDK_URL=
ANIME_SDK_CONTENT_PROVIDERS=megaplay,animeparadise,allmanga,gogoanime

# Gateway tuning
PROVIDER_GATEWAY_CACHE_MS=120000
PROVIDER_GATEWAY_TIMEOUT_MS=4500
# MERISTREAM_DISABLED_DIRECT_PROVIDERS=nuvio,flixquest,anime-sdk,streamprovider

# ── SubtitleGateway ─────────────────────────────────────────────
# Keyless OpenSubtitles v3, TVSubtitles and YIFY adapters. The browser only
# receives MeriStream /api/v1/subtitles/file/:token.vtt URLs.
OPENSUBTITLES_V3_ENDPOINTS=https://opensubtitles-v3.strem.io,https://opensubtitles.stremio.homes,https://opensubtitles.strem.io
OPENSUBTITLES_V3_TIMEOUT_MS=7000
TVSUBTITLES_TIMEOUT_MS=10000
YIFY_SUBTITLES_BASE_URL=https://www.yifysubtitles.ch,https://yts-subs.com
YIFY_SUBTITLES_TIMEOUT_MS=8000
SUBTITLE_PROVIDER_TIMEOUT_MS=8000
SUBTITLE_SEARCH_CACHE_TTL_MS=14400000
SUBTITLE_PROXY_TIMEOUT_MS=15000
SUBTITLE_PROXY_MAX_BYTES=12582912
SUBTITLE_PROXY_CACHE_TTL_MS=604800000
