# Copy to .env and replace every value marked CHANGE_ME.
# Use a URL-safe PostgreSQL password because Compose builds DATABASE_URL from it.

POSTGRES_IMAGE=postgres:18.6-alpine
POSTGRES_USER=meristream
POSTGRES_PASSWORD=CHANGE_ME_long_random_url_safe_password
POSTGRES_DB=meristream
POSTGRES_HOST_PORT=5433

APP_HOST_PORT=3010
APP_MEM_LIMIT=1024m
POSTGRES_MEM_LIMIT=1536m
APP_CPUS=2.0
POSTGRES_CPUS=2.0

ADMIN_USER=admin
ADMIN_PASS=CHANGE_ME_long_random_admin_password
ADMIN_SESSION_SECRET=CHANGE_ME_long_random_admin_session_secret
JWT_SECRET=CHANGE_ME_long_random_jwt_secret

# Leave empty if TMDB enrichment is not configured.
TMDB_API_KEY=

# Comma-separated browser origins allowed by the API.
ALLOWED_ORIGINS=http://localhost:3010
TRUST_PROXY_HOPS=0
ENFORCE_HTTPS=false

# Provider defaults. These can be overridden for a private installation.
FLIXQUEST_API_URL=https://flixquest-api.vercel.app
FLIXQUEST_PROVIDER_IDS=showbox,vidsrc,vidsrcto
NUVIO_STREAMS_URL=https://nuviostreams.hayd.uk
ANIME_SDK_URL=
ANIME_SDK_CONTENT_PROVIDERS=megaplay,animeparadise,allmanga,gogoanime
OPENSUBTITLES_V3_ENDPOINTS=https://opensubtitles-v3.strem.io,https://opensubtitles.strem.io
OPENSUBTITLES_V3_TIMEOUT_MS=7000
TVSUBTITLES_TIMEOUT_MS=10000
YIFY_SUBTITLES_BASE_URL=https://www.yifysubtitles.ch,https://yts-subs.com
YIFY_SUBTITLES_TIMEOUT_MS=8000
SUBTITLE_PROVIDER_TIMEOUT_MS=8000
SUBTITLE_SEARCH_CACHE_TTL_MS=14400000
SUBTITLE_PROXY_TIMEOUT_MS=15000
SUBTITLE_PROXY_MAX_BYTES=12582912
SUBTITLE_PROXY_CACHE_TTL_MS=604800000
