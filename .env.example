# ══════════════════════════════════════════════════════════════════
# VoidStream / Nitiflix - Variables de Entorno
# ══════════════════════════════════════════════════════════════════
#
# MODO POSTGRESQL (default desde v6.0, máxima velocidad):
#   1. Arrancar PostgreSQL: docker run -d --name voidstream-pg \
#        -e POSTGRES_HOST_AUTH_METHOD=trust -e POSTGRES_DB=voidstream \
#        -e POSTGRES_USER=voidstream -e POSTGRES_PASSWORD=voidstream123 \
#        -p 5433:5432 postgres:16-alpine
#   2. Copia este archivo: cp .env.example .env
#   3. npx prisma db push && npx prisma generate
#   4. Migra datos: npx tsx tools/fast-migrate-pg.ts
#   5. Agrega full-text search: npx tsx tools/add-fulltext-search.ts
#   6. Arranca: npm run dev
#
# MODO SQLITE (legacy):
#   1. Cambia schema.prisma: provider = "sqlite"
#   2. Quitar .env (usa DATABASE_URL="file:./dev.db")
#   3. npx prisma db push
#
# MODO TURSO/libSQL (SQLite distribuido, edge-ready):
#   1. Regístrate en turso.tech (gratis)
#   2. Crea una base: turso db create voidstream
#   3. DATABASE_URL="libsql://voidstream-[tu-org].turso.io"
#   4. TURSO_AUTH_TOKEN="tu-token-aqui"
#
# ══════════════════════════════════════════════════════════════════

# ── PostgreSQL (default, Docker) ──
DATABASE_URL="postgresql://voidstream:voidstream123@localhost:5433/voidstream?schema=public"

# ── PostgreSQL (producción) ──
# DATABASE_URL="postgresql://user:password@localhost:5432/voidstream?schema=public"

# ── SQLite (legacy, sin .env necesario) ──
# DATABASE_URL="file:./dev.db"

# ── Administración (obligatorio para habilitar /admin) ──
# Genera ADMIN_SESSION_SECRET con al menos 32 bytes aleatorios.
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-contrasena
ADMIN_SESSION_SECRET=genera-un-secreto-largo-y-aleatorio
