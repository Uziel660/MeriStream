{
  "name": "meristream",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "cross-env NODE_ENV=production node --max-old-space-size=8192 dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "bootstrap": "npx tsx tools/bootstrap-catalog.ts",
    "ingest:all": "npx tsx tools/ingest-all.ts",
    "hydrate:sources": "npx tsx tools/hydrate-tmdb-sources.ts",
    "provider:api": "npx tsx tools/provider-api.ts",
    "hydrate:sources:legacy": "npx tsx tools/run_source_recovery.ts",
    "deploy": "python tools/deploy_fast.py",
    "fast-start": "npm run ingest:all -- --fast",
    "repair:tmdb": "npx tsx tools/repair-tmdb-identities.ts",
    "repair:tmdb:safe": "npx tsx tools/repair-tmdb-identities-safe.ts",
    "repair:source-languages": "npx tsx tools/repair-source-languages.ts",
    "repair:doramasyt-languages": "npx tsx tools/repair-doramasyt-languages.ts",
    "link:doramasyt-variants": "npx tsx tools/link-doramasyt-variants.ts",
    "repair:anime-identities": "npx tsx tools/repair-anime-identities.ts",
    "repair:catalog:ids": "npx tsx tools/repair-catalog-identities.ts",
    "verify:catalog:ids": "npx tsx tools/verify-catalog-identities.ts",
    "sync:local-catalog": "npx tsx tools/sync-local-catalog-index.ts",
    "repair:catalog-links": "npx tsx tools/cleanup-landing-pages-from-episodes.ts",
    "reconcile:tmdb": "npx tsx tools/reconcile-tmdb-seasons.ts",
    "backfill:canonical": "npx tsx tools/backfill-canonical-locators.ts",
    "backfill:legacy-sources": "npx tsx tools/backfill-legacy-source-links.ts",
    "normalize:source-sites": "npx tsx tools/normalize-source-sites.ts",
    "normalize:legacy-titles": "npx tsx tools/normalize-legacy-titles.ts",
    "finalize:pipeline": "npx tsx tools/finalize-catalog-pipeline.ts",
    "merge-dbs": "npx tsx tools/merge-dbs.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:live": "cross-env LIVE_SCRAPER_E2E=1 playwright test --project=chromium",
    "test:e2e:list": "playwright test --project=chromium --list"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^4.0.2",
    "@electric-sql/pglite": "^0.5.5",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^5.22.0",
    "ai": "^7.0.93",
    "ass-compiler": "^0.1.16",
    "bcryptjs": "^3.0.3",
    "chardet": "^2.2.0",
    "cheerio": "^1.2.0",
    "colorthief": "^3.5.0",
    "cors": "^2.8.6",
    "dashjs": "^5.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "fflate": "^0.8.3",
    "hls.js": "^1.5.15",
    "iconv-lite": "^0.7.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.462.0",
    "megajs": "^1.3.10",
    "motion": "^13.1.0",
    "plyr": "^3.8.4",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.17.7",
    "subtitle": "^4.2.2",
    "undici": "^8.10.0",
    "ws": "^8.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/colorthief": "^2.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "stream-json": "3.5.0"
  }
}
