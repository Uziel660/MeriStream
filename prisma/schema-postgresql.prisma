// prisma/schema-postgresql.ts
// ══════════════════════════════════════════════════════════════════
// Schema Prisma para PostgreSQL (migración desde SQLite)
//
// Para usar:
//   1. Copiar este archivo a schema.prisma
//   2. Setear DATABASE_URL en .env:
//      DATABASE_URL="postgresql://user:password@localhost:5432/voidstream?schema=public"
//   3. npx prisma db push
//   4. npx tsx tools/migrate-sqlite-to-pg.ts
// ══════════════════════════════════════════════════════════════════

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Show {
  id                   String    @id @default(cuid())
  mal_id               Int?      @unique
  anilist_id           String?
  kitsu_id             String?
  tmdb_id              Int?
  title                String
  original_title       String?
  japanese_title       String?
  english_title        String?
  normalized_title     String
  base_normalized_title String?
  description          String    @default("")
  poster_url           String?
  banner_url           String?
  poster_path          String?
  backdrop_path        String?
  category             String    @default("anime")
  rating               Float     @default(8.0)
  year                 Int       @default(2024)
  status               String    @default("Finalizado")
  genres               String    @default("Multimedia")
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  episodes             Episode[]

  @@index([normalized_title])
  @@index([base_normalized_title])
  @@index([tmdb_id])
}

/// User-submitted catalog quality reports. The identity fields are copied at
/// submission time so a report remains useful even if a catalog row is later
/// merged, renamed, or removed.
model CatalogReport {
  id                String   @id @default(cuid())
  show_id           String?
  tmdb_id           Int?
  kind              String?
  title             String
  episode_id        String?
  episode_number    Float?
  report_type       String
  details           String?  @db.Text
  source_provider   String?
  source_url        String?  @db.Text
  status            String   @default("open")
  admin_note        String?  @db.Text
  resolution_action String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  resolved_at       DateTime?

  @@index([status, created_at])
  @@index([show_id])
  @@index([tmdb_id, kind])
  @@index([report_type])
}

model Episode {
  id             String   @id @default(cuid())
  show_id        String
  show           Show     @relation(fields: [show_id], references: [id], onDelete: Cascade)
  title          String
  episode_number Float
  source_url     String    @default("")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([show_id])
}

model CrawlTask {
  id                  String   @id
  name                String
  target_url          String
  status              String
  scope               String   @default("catalog_pages")
  max_pages           Int      @default(1)
  current_page        Int      @default(0)
  total_discovered    Int      @default(0)
  shows_imported      Int      @default(0)
  episodes_imported   Int      @default(0)
  rate_limit_delay_ms Int      @default(1500)
  items_queue         String    @default("[]") @db.Text
  current_item_title  String?
  error_message       String?
  logs                String    @default("[]") @db.Text
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

model WorkerSettingsStore {
  id                  String   @id @default("default")
  default_delay_ms     Int      @default(1500)
  jitter_enabled       Boolean  @default(true)
  max_concurrent_jobs  Int      @default(3)
  user_agent_rotation Boolean  @default(true)
  updated_at           DateTime @updatedAt
}

model MediaItem {
  id                    String   @id @default(cuid())
  normalized_title      String
  base_normalized_title String?
  title                 String
  original_title        String?
  tmdb_id               Int?
  kind                  String   @default("movie")
  year                  Int?
  poster_url            String?
  poster_path           String?
  backdrop_path         String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  episodes         MediaEpisode[]

  @@unique([normalized_title, kind, year])
  @@index([normalized_title])
  @@index([base_normalized_title])
  @@index([tmdb_id])
}

model CatalogVisibility {
  id              String   @id @default("default")
  hidden_genres   String   @default("[]") @db.Text
  hidden_show_ids String   @default("[]") @db.Text
  updated_at      DateTime @updatedAt
}

model SiteRating {
  id      String  @id @default(cuid())
  site    String  @unique
  rating  Float   @default(5.0)
  enabled Boolean @default(true)
  notes   String?
  updated_at DateTime @updatedAt
}

model MediaEpisode {
  id             String     @id @default(cuid())
  media_item_id  String
  media_item     MediaItem  @relation(fields: [media_item_id], references: [id], onDelete: Cascade)
  season_number  Int        @default(1)
  episode_number Float
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  links          SourceLink[]

  @@unique([media_item_id, season_number, episode_number])
}

model SourceLink {
  id               String       @id @default(cuid())
  media_episode_id String
  media_episode    MediaEpisode @relation(fields: [media_episode_id], references: [id], onDelete: Cascade)

  source_site    String
  url            String
  link_type      String    @default("direct")
  // Metadata opcional de rendición; las filas históricas pueden quedar nulas.
  language          String?
  audio_language    String?
  subtitle_language String?
  subtitles         Json?
  host           String?
  priority_tier  Int?
  is_verified    Boolean   @default(false)
  last_checked   DateTime?
  // Estado de evidencia; is_verified se conserva por compatibilidad histórica.
  source_status  String    @default("discovered")
  canonical_locator String?
  external_id    String?
  extraction_method String?
  resolver_version String?
  failure_reason String?
  last_success   DateTime?
  last_failure   DateTime?
  retry_after    DateTime?

  @@unique([media_episode_id, source_site, url])
  @@index([media_episode_id, source_status])
  @@index([source_site, source_status])
}
