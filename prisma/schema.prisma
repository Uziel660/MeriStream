datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model Show {
  id                   String    @id @default(cuid())
  mal_id               Int?      @unique
  anilist_id           String?
  kitsu_id             String?
  tmdb_id              Int?
  title                String
  original_title       String?
  japanese_title       String?
  english_title        String?
  normalized_title     String
  base_normalized_title String?
  description          String    @default("")
  poster_url           String?
  banner_url           String?
  poster_path          String?
  backdrop_path        String?
  category             String    @default("movie")
  rating               Float     @default(8.0)
  year                 Int       @default(2024)
  status               String    @default("Finalizado")
  genres               String    @default("Multimedia")
  source               String    @default("")
  search_vector        Unsupported("tsvector")?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  episodes             Episode[]

  @@index([normalized_title])
  @@index([base_normalized_title])
  @@index([tmdb_id])
}

model Episode {
  id             String   @id @default(cuid())
  show_id        String
  show           Show     @relation(fields: [show_id], references: [id], onDelete: Cascade)
  title          String
  episode_number Float
  source_url     String    @default("")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([show_id])
}

model CrawlTask {
  id                  String   @id
  name                String
  target_url          String
  status              String
  scope               String   @default("catalog_pages")
  max_pages           Int      @default(1)
  current_page        Int      @default(0)
  total_discovered    Int      @default(0)
  shows_imported      Int      @default(0)
  episodes_imported   Int      @default(0)
  rate_limit_delay_ms Int      @default(1500)
  items_queue         String    @default("[]") @db.Text
  current_item_title  String?
  error_message       String?
  logs                String    @default("[]") @db.Text
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

model WorkerSettingsStore {
  id                  String   @id @default("default")
  default_delay_ms     Int      @default(1500)
  jitter_enabled       Boolean  @default(true)
  max_concurrent_jobs  Int      @default(3)
  user_agent_rotation Boolean  @default(true)
  updated_at           DateTime @updatedAt
}

model MediaItem {
  id                    String   @id @default(cuid())
  normalized_title      String
  base_normalized_title String?
  title                 String
  original_title        String?
  description           String   @default("")
  rating                Float    @default(0)
  genres                String   @default("")
  tmdb_id               Int?
  kind                  String   @default("movie")
  year                  Int?
  poster_url            String?
  poster_path           String?
  backdrop_path         String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  episodes         MediaEpisode[]

  @@unique([normalized_title, kind, year])
  @@index([normalized_title])
  @@index([base_normalized_title])
  @@index([tmdb_id])
}

model SiteRating {
  id      String  @id @default(cuid())
  site    String  @unique
  rating  Float   @default(5.0)
  enabled Boolean @default(true)
  notes   String?
  updated_at DateTime @updatedAt
}

model MediaEpisode {
  id             String     @id @default(cuid())
  media_item_id  String
  media_item     MediaItem  @relation(fields: [media_item_id], references: [id], onDelete: Cascade)
  season_number  Int        @default(1)
  episode_number Float
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  links          SourceLink[]

  @@unique([media_item_id, season_number, episode_number])
}

model SourceLink {
  id               String       @id @default(cuid())
  media_episode_id String
  media_episode    MediaEpisode @relation(fields: [media_episode_id], references: [id], onDelete: Cascade)

  source_site    String
  url            String
  link_type      String    @default("direct")
  language          String?
  audio_language    String?
  subtitle_language String?
  subtitles         Json?
  host           String?
  priority_tier  Int?
  is_verified    Boolean   @default(false)
  last_checked   DateTime?
  source_status  String    @default("discovered")
  canonical_locator String?
  external_id    String?
  extraction_method String?
  resolver_version String?
  failure_reason String?
  last_success   DateTime?
  last_failure   DateTime?
  retry_after    DateTime?

  @@unique([media_episode_id, source_site, url])
  @@index([media_episode_id, source_status])
  @@index([source_site, source_status])
}

model User {
  id            String          @id @default(cuid())
  username      String          @unique
  password_hash String
  avatar        String?         @default("amber")
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  watch_history WatchProgress[]
}

model WatchProgress {
  id               String   @id @default(cuid())
  user_id          String
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  show_id          String
  show_title       String
  show_poster      String?
  episode_id       String
  episode_number   Float
  episode_title    String
  progress_percent Float    @default(0)
  current_time     Float?   @default(0)
  duration         Float?   @default(0)
  last_watched_at  DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([user_id, show_id, episode_id])
  @@index([user_id])
  @@index([show_id])
  @@index([last_watched_at])
}
